filters:
  and:
    - file.inFolder("05_IA_Inbox/Audits")
    - file.ext == "md"
properties:
  file.name:
    displayName: Journal
  cible:
    displayName: Cible
  date:
    displayName: Session
  statut:
    displayName: Statut
views:
  - type: table
    name: Audits à trancher
    order:
      - file.name
      - cible
      - date
      - statut
